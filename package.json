{
  "name": "@evanfurniss-dev/mcp-customer-router",
  "version": "0.1.0",
  "description": "Local customer-bound Glide MCP connections shared by Claude Code and Codex",
  "keywords": [
    "mcp",
    "stdio",
    "sse",
    "remote",
    "oauth"
  ],
  "author": "Glen Maddern <glen@glenmaddern.com>",
  "license": "MIT",
  "repository": "https://github.com/evanfurniss-dev/mcp-customer-router",
  "type": "module",
  "files": [
    "dist",
    "web/dist",
    "web/licenses",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "mcp-customer-router": "dist/router-cli.js"
  },
  "scripts": {
    "build": "pnpm build:bridge && pnpm --dir web build",
    "build:watch": "tsup --watch",
    "dev:client": "tsx src/client.ts",
    "dev:proxy": "tsx src/proxy.ts",
    "format": "oxfmt .",
    "knip": "knip",
    "lint": "oxfmt --check . && oxlint --deny-warnings && tsc && tsc -p test --noEmit",
    "prepack": "pnpm build",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:bridge": "tsup",
    "release:package": "node scripts/package-release.mjs",
    "release:smoke": "node scripts/smoke-release.mjs",
    "start": "node dist/router-cli.js dashboard --open",
    "check:router": "vitest run src/router"
  },
  "dependencies": {
    "express": "^4.22.3",
    "open": "^10.1.0",
    "smol-toml": "1.9.1",
    "strict-url-sanitise": "^0.0.1",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/core": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "husky": "9.1.7",
    "knip": "6.32.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.80.0",
    "postcss": "8.5.31",
    "tsup": "8.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "6.4.4",
    "vitest": "4.1.12",
    "zod": "^4.2.0"
  },
  "tsup": {
    "entry": [
      "src/client.ts",
      "src/proxy.ts",
      "src/router-cli.ts",
      "src/router-connection.ts"
    ],
    "format": [
      "esm"
    ],
    "dts": true,
    "clean": true,
    "outDir": "dist",
    "external": []
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
